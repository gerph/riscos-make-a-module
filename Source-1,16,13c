.jfilter_twcheck
   B       filter_twcheck

; *******************************************************************
; Subroutine:   finalise
; Description:  Shutdown the module - we'll kill everything off that
;               we know about
; Parameters:   none
; Returns:      none
; *******************************************************************
>finalise
   STMFD   (sp)!,{r0-r5,r10,r11,link}    ; Stack registers
   MOV     r5,#0                         ; no 'last' one
; monitors first as they refer to sockets
$losemonitors
   LDRW    r0,`monitors
   TEQ     r0,#0                         ; last one
   BEQ     $nomoremonitors
   TEQ     r0,r5                         ; did it go back to the same one ?
   BEQ     $nomoremonitors               ; if didn't release, exit
   MOV     r5,r0                         ; hang on to current one as last
   BL      swi_forget                    ; try to forget it
   B       $losemonitors
$nomoremonitors
   MOV     r5,#0                         ; no 'last' one
; now sockets
$losesockets
   LDRW    r0,`sockets
   TEQ     r0,#0                         ; last one
   BEQ     $nomoresockets
   TEQ     r0,r5                         ; did it go back to the same one ?
   BEQ     $nomoresockets                ; if didn't release, exit
   MOV     r5,r0                         ; hang on to current one as last
   BL      swi_forget                    ; try to forget it
   B       $losesockets
$nomoresockets
   LDMFD   (sp)!,{r0-r5,r10,r11,pc}      ; Return from call

; *******************************************************************
; Subroutine:   svc_wimpclosedown (Wimp_CloseDown)
; Description:  Checks if the task closing down is one we have a block for
; Parameters:   r0 = 0 if closing down
;               r2 = task handle (unused)
; Returns:      none
; *******************************************************************
>svc_wimpclosedown
   STMFD   (sp)!,{r0-r1,r10,r11,link}    ; Stack registers
;    REM     "%c04%c30Closing down, r0=%&0"
   CMP     r0,#0                         ; is it closedown ?
   LDMNEFD (sp)!,{r0-r1,r10,r11,pc}^     ; if not, exit
; first try shutting any monitors
$tryagain_monitors
   LDR     r0,[r0,#&ff8]                 ; read domain id of dying task
   LDRW    r10,`monitors                 ; read head of monitors list
   RAS     r10,r0,#`mon_domain           ; find it in the list
   TEQ     r10,#0                        ; was there one
   BEQ     $tryagain_sockets
   XBL     swi_forget,r10                ; forget it!
   MOV     r0,#0
   B       $tryagain_monitors

$tryagain_sockets
   MOV     r0,#0                         ; base page
   LDR     r0,[r0,#&ff8]                 ; read domain id of dying task
   LDRW    r11,`sockets                  ; read head of sockets list
   RAS     r11,r0,#`domain               ; find it in the list
   TEQ     r11,#0                        ; was there one
   LDMEQFD (sp)!,{r0-r1,r10,r11,pc}^     ; if so, return from call
   XBL     swi_forget,r11                ; forget it!
   B       $tryagain_sockets

; *******************************************************************
; Subroutine:   swi_connecttohost (ESocket_ConnectToHost)
; Description:  Connect to a host
; Parameters:   r0 = host name
;               r1 = port
; Returns:      handle, or -ve if error
; *******************************************************************
>swi_connecttohost
   STMFD   (sp)!,{r0-r5,r11,link}        ; Stack registers
; create a block
   LDRW    r2,`sockets                   ; read sockets pointer
   XBL     claim,`len_socket             ; claim space for it
   MOV     r11,r0                        ; r11-> our workspace
   STRW    r2,`next                      ; link next to us
   STRW    r11,`sockets                  ; make us the head
   LDR     r0,`MAGIC                     ; magic
   STRW    r0,`magic                     ; store it
   MOV     r0,#InitialBuffer             ; size of initial buffer
   STRW    r0,`buflen                    ; store as buffer length
   BL      claim                         ; claim that much space
   STRW    r0,`buffer                    ; store ptr in block
   MOV     r0,#0                         ; no data yet
   STRW    r0,`datalen                   ; store in block
   LDR     r2,[r0,#&ff8]                 ; read domain ID
   STRW    r2,`domain                    ; store domain ID
; put our data in
   LDR     r0,[sp]                       ; re-read host name
   BL      strdup                        ; copy it
   STRW    r0,`addr                      ; store as the address
   STRW    r1,`port                      ; store the port number
   MVN     r0,#NOT -1                    ; -1 for socket handle
   STRW    r0,`socket                    ; store the handle
   MOV     r0,#S_Lookup                  ; we're looking up at the moment
   STRW    r0,`state                     ; store as the state
   BL      checksockets                  ; check them
   STR     r11,[sp]                      ; store the handle there
   REM     "%c04Connect to host done, returning %&B"
   LDMFD   (sp)!,{r0-r5,r11,pc}^         ; Return from call


; *******************************************************************
; Subroutine:   swi_connecttoaddr (ESocket_ConnectToAddr)
; Description:  Connect to a host, given its address
; Parameters:   r0 = host address (IP)
;               r1 = port
; Returns:      handle, or -ve if error
; *******************************************************************
>swi_connecttoaddr
   STMFD   (sp)!,{r0-r5,r11,link}        ; Stack registers
; create a block
   LDRW    r2,`sockets                   ; read sockets pointer
   XBL     claim,`len_socket             ; claim space for it
   MOV     r11,r0                        ; r11-> our workspace
   STRW    r2,`next                      ; link next to us
   STRW    r11,`sockets                  ; make us the head
   LDR     r0,`MAGIC                     ; magic
   STRW    r0,`magic                     ; store it
   MOV     r0,#InitialBuffer             ; size of initial buffer
   STRW    r0,`buflen                    ; store as buffer length
   BL      claim                         ; claim that much space
   STRW    r0,`buffer                    ; store ptr in block
   MOV     r0,#0                         ; no data yet
   STRW    r0,`datalen                   ; store in block
   LDR     r2,[r0,#&ff8]                 ; read domain ID
   STRW    r2,`domain                    ; store domain ID
; put our data in
   LDR     r0,[sp]                       ; re-read IP
   ADRW    r1,`hostname                  ; address of our hostname block
   BL      makedottedip                  ; create a dotted IP
   ADRW    r0,`hostname                  ; get the hostname address again
   BL      strdup                        ; copy it
   STRW    r0,`addr                      ; store as the address
   LDR     r1,[sp,#4]                    ; re-read port number
   STRW    r1,`port                      ; store the port number
   MVN     r0,#NOT -1                    ; -1 for socket handle
   STRW    r0,`socket                    ; store the handle
   MOV     r0,#S_Lookup                  ; we're looking up at the moment
   STRW    r0,`state                     ; store as the state
   BL      checksockets                  ; check them
   STR     r11,[sp]                      ; store the handle there
   LDMFD   (sp)!,{r0-r5,r11,pc}^         ; Return from call

; *******************************************************************
; Subroutine:   checksockets
; Description:  check for data in the sockets
; Parameters:   none
; Returns:      none
; *******************************************************************
>checksockets
   STMFD   (sp)!,{r0-r5,r11,link}        ; Stack registers
   LDRW    r11,`sockets                  ; read head of sockets list
$loop
   TEQ     r11,#0                        ; is it 0 ?
   LDMEQFD (sp)!,{r0-r5,r11,pc}^         ; if so, return from call

   LDRW    r0,`state                     ; read state of handle
   TEQ     r0,#S_Lookup                  ; is it in lookup?
   BNE     $notlookup                    ; nope, so skip code

   LDRW    r0,`addr                      ; get address of host
   REM     "%c04Trying a lookup of %$0"
   BL      Resolver_GetHost
   MVNVS   r0,#NOT S_ResolveError        ; if error, resolver error
   REM     "Returned value = %r0, %&1"
   TEQ     r0,#36                        ; is it 'pending' ?
   BEQ     $getnext                      ; if so, we know nothing
   TEQ     r1,#0                         ; did it fail ?
   MVNEQ   r0,#NOT S_ResolveError        ; if so, return resolver error
   CMP     r0,#0                         ; did it succeed ?
   STRWLT  r0,`state                     ; if so, store in block
   BLT     $getnext                      ;        and jump out
   LDR     r3,[r1,#16]                   ; r3-> pointer list of addresses
   LDR     r3,[r3]                       ; read pointer to address
   LDR     r3,[r3]                       ; read address
   REM     "Looked up addr = %&3"

   XSWI    "XSocket_Creat",2,1,0         ; create a socket
   MVNVS   r0,#NOT S_NoSockets           ; if error, no sockets left
   STRWVS  r0,`state                     ;           store as state
   BVS     $getnext                      ;           next one
   STRW    r0,`socket                    ; store socket handle
   MOV     r4,r0

   REM     "Socket number = %r4"

   MOV     r1,#S_Connecting              ; trying to connect
   STRW    r1,`state                     ; store the state

   REM     "Making non-blocking/asynchronous"
   LDR     r1,`FIONBIO                   ; read the FIONBIO item
   XSWI    "XSocket_Ioctl",,,^$`true     ; make it non blocking
   LDR     r1,`FIOASYNC                  ; read the FIOASYNC item
   XSWI    "XSocket_Ioctl",r4,,^$`true   ; make it non blocking

   LDRW    r0,`port                      ; read port number
   REM     "Connecting to %&3, port %r0"
   BL      htons                         ; reverse it
   MOV     r0,r0,LSL #16                 ; put it in the top
   ADD     r0,r0,#2                      ; add 2 (AF_INET)
   ADRW    r1,`address                   ; r1-> address block
   STR     r0,[r1]                       ; store port at bottom of address
   STR     r3,[r1,#4]                    ; store address
   XSWI    "XSocket_Connect",r4,,16      ; connect us
   B       $checkconnectcode             ; jump to connect checking

$notlookup
   TEQ     r0,#S_Connecting              ; is it in connecting
   BNE     $notconnecting                ; nope, so skip code

   LDRW    r0,`socket                    ; read socket handle
   XBL     selectready,,0                ; is it ready for 'write' ?
   TEQ     r0,#0                         ; is it ready ?
   BEQ     $getnext                      ; no, so just skip out

   LDRW    r0,`socket                    ; read socket handle
   ADRW    r1,`address                   ; space to read into
   XSWI    "XSocket_Recv",,,1,&82        ; address of buffer without wait

$checkconnectcode
   BVS     $errorset
$connected
   MOV     r1,#S_Connected               ; if no error, we're connected
   STRW    r1,`state                     ; store as state
   B       $getnext                      ; exit

$errorset
   LDR     r0,[r0]                       ; read error number
   REM     "Error number = %r0"
   TEQ     r0,#35                        ; is it 'would block' ?
   BEQ     $connected                    ; if so, we really are connected

   TEQ     r0,#50                        ; net down
   TEQNE   r0,#51                        ; net unreachable
   TEQNE   r0,#60                        ; timed out
   MVNEQ   r1,#NOT S_Unreachable         ; it's unreachable
   STRWEQ  r1,`state                     ; store as state

;    TEQ     r0,#54                        ; connection reset
;    TEQNE   r0,#53                        ; Connection aborted
;    MVNEQ   r1,#NOT S_Closed              ; it's been closed
;    STRWEQ  r1,`state                     ; store as state

   TEQ     r0,#61                        ; connection refused
   MVNEQ   r1,#NOT S_NotListening        ; Connection refused
   STRWEQ  r1,`state                     ; store as state

$notconnecting
   TEQ     r0,#S_Connected               ; is it connected ?
   BNE     $notconnected                 ; nope, so skip code

   LDRW    r0,`addr                      ; read address pointer
   TEQ     r0,#0                         ; is it valid ?
   BNE     $getnext                      ; if so, skip lookup
   LDRW    r0,`socket                    ; read socket handle
   ADRW    r1,`address                   ; pointer to address block
   XSWI    "XSocket_Getpeername",,,^$`sixteen ; get peername
   BVS     $getnext                      ; if error, exit
   LDR     r0,[r1]                       ; read the address port bit
   MOV     r0,r0,LSR #16                 ; shift down
   BL      htons                         ; convert to short
   STRW    r0,`port                      ; store as the port number
   BL      lookupaddress                 ; attempt to lookup address

$notconnected
; get next
$getnext
   LDRW    r11,`next                     ; read next pointer
   B       $loop                         ; go for more

$`sixteen
   EQUD    16
$`true
   EQUD    1

; *******************************************************************
; Subroutine:   htonl(host) & ntohl(host)
; Description:  Host to network order (long) (and the inverse)
; Parameters:   host = host in ro byte order
; Returns:      host in net byte order
; *******************************************************************
; >htonl
;    STMFD   (sp)!,{link}
;    EOR     r14,r0,r0,ROR #16
;    BIC     r14,r14,#&FF0000
;    MOV     r0,r0,ROR #8
;    EOR     r0,r0,r1,LSR #8
;    LDMFD   (sp)!,{pc}^

; *******************************************************************
; Subroutine:   htons(port) & ntohs(port)
; Description:  Host to network (short) (and inverse)
; Parameters:   port (r0) = short to convert
; Returns:      network order version
; *******************************************************************
>htons
   STMFD   (sp)!,{r2,link}
   MOV     r2,#255
   AND     r14,r2,r0,LSR #8
   AND     r0,r0,r2
   ORR     r0,r14,r0,LSL #8
   LDMFD   (sp)!,{r2,pc}^

