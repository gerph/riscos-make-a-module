#define Resolver_GetHost 0x66001

static socket_handle_t *socket_list = NULL;
static socket_monitor_t *monitor_list = NULL;

static char *socket_strdup(const char *s)
{
    size_t len = strlen(s) + 1;
    char *new_s = malloc(len);
    if (new_s) memcpy(new_s, s, len);
    return new_s;
}

static unsigned int get_current_task(void)
{
    unsigned int *ptr = (unsigned int *)0x0;
    return ptr[0xff8/4];
}

_kernel_oserror *socket_init(void)
{
    socket_list = NULL;
    monitor_list = NULL;
    return NULL;
}

static void socket_free(socket_handle_t *h)
{
    socket_monitor_t **mcurr;
    mcurr = &monitor_list;
    while (*mcurr) {
        if ((*mcurr)->handle == h) {
            socket_monitor_t *to_free = *mcurr;
            *mcurr = to_free->next;
            free(to_free);
        } else {
            mcurr = &((*mcurr)->next);
        }
    }
    if (h->socket_fd != -1) {
        shutdown(h->socket_fd, 2);
        close(h->socket_fd);
    }
    if (h->remote_name) free(h->remote_name);
    if (h->buffer) free(h->buffer);
    free(h);
}

_kernel_oserror *socket_final(void)
{
    while (socket_list) {
        socket_handle_t *next = socket_list->next;
        socket_free(socket_list);
        socket_list = next;
    }
    return NULL;
}

_kernel_oserror *socket_validate(int handle, socket_handle_t **out)
{
    socket_handle_t *h = socket_list;
    while (h) {
        if ((int)h == handle) {
            if (h->magic == SOCKET_MAGIC) {
                *out = h;
                return NULL;
            }
            break;
        }
        h = h->next;
    }
    return Err_BadHandle;
}

_kernel_oserror *socket_monitor_validate(int monitor, socket_monitor_t **out)
{
    socket_monitor_t *m = monitor_list;
    while (m) {
        if ((int)m == monitor) {
            if (m->magic == MONITOR_MAGIC) {
                *out = m;
                return NULL;
            }
            break;
        }
        m = m->next;
    }
    return Err_BadHandle;
}

static socket_handle_t *socket_alloc(void)
{
    socket_handle_t *h = malloc(sizeof(socket_handle_t));
    if (h) {
        _kernel_swi_regs regs;
        memset(h, 0, sizeof(socket_handle_t));
        h->magic = SOCKET_MAGIC;
        h->socket_fd = -1;
        h->buffer_size = 256; // InitialBuffer
        h->buffer = malloc(h->buffer_size);
        if (!h->buffer) {
            free(h);
            return NULL;
        }
        h->task_handle = get_current_task();
        h->next = socket_list;
        socket_list = h;
    }
    return h;
}

static _kernel_oserror *parse_ip_literal(const char *hostname, unsigned int *ip)
{
    if (hostname[0] == '[') {
        char *end;
        unsigned int a, b, c, d;
        const char *p = hostname + 1;
        a = strtoul(p, &end, 10); if (*end != '.') return Err_BadHandle; p = end + 1;
        b = strtoul(p, &end, 10); if (*end != '.') return Err_BadHandle; p = end + 1;
        c = strtoul(p, &end, 10); if (*end != '.') return Err_BadHandle; p = end + 1;
        d = strtoul(p, &end, 10); if (*end != ']') return Err_BadHandle;
        *ip = (a & 0xFF) | ((b & 0xFF) << 8) | ((c & 0xFF) << 16) | ((d & 0xFF) << 24);
        return NULL;
    }
    return Err_BadHandle;
}

_kernel_oserror *socket_connect(const char *hostname, int port, socket_handle_t **handle)
{
    socket_handle_t *h = socket_alloc();
    if (!h) {
        static _kernel_oserror err_mem = {0, "Out of memory"};
        return &err_mem;
    }

    h->remote_name = socket_strdup(hostname);
    h->port = port;
    h->state = 1; // S_Lookup
    *handle = h;

    socket_check_all();
    return NULL;
}

_kernel_oserror *socket_connect_addr(unsigned int ip, int port, socket_handle_t **handle)
{
    char buf[32];
    sprintf(buf, "[%u.%u.%u.%u]", ip & 0xFF, (ip >> 8) & 0xFF, (ip >> 16) & 0xFF, (ip >> 24) & 0xFF);
    return socket_connect(buf, port, handle);
}

void socket_check_all(void)
{
    socket_handle_t *h = socket_list;
    while (h) {
        if (h->state == 1) { // S_Lookup
            unsigned int ip;
            if (parse_ip_literal(h->remote_name, &ip) == NULL) {
                // IP literal
                struct sockaddr_in sin;
                int s = socket(AF_INET, SOCK_STREAM, 0);
                if (s >= 0) {
                    int on = 1;
                    h->socket_fd = s;
                    ioctl(s, FIONBIO, &on);
                    ioctl(s, FIOASYNC, &on);
                    memset(&sin, 0, sizeof(sin));
                    sin.sin_family = AF_INET;
                    sin.sin_port = htons(h->port);
                    sin.sin_addr.s_addr = ip;
                    if (connect(s, (struct sockaddr *)&sin, sizeof(sin)) < 0) {
                        if (errno == EINPROGRESS) h->state = 2; // S_Connecting
                        else h->state = -5; // S_Unreachable
                    } else {
                        h->state = 4; // S_Connected
                    }
                } else {
                    h->state = -4; // S_NoSockets
                }
            } else {
                // DNS Lookup
                _kernel_swi_regs regs;
                regs.r[0] = (int)h->remote_name;
                if (!_swix(Resolver_GetHost, _INR(0,0)|_OUTR(0,1), &regs)) {
                    if (regs.r[0] == 36) { // Pending
                        // Still lookup
                    } else if (regs.r[1] != 0) {
                        // Success
                        struct hostent *hp = (struct hostent *)regs.r[1];
                        struct sockaddr_in sin;
                        int s = socket(AF_INET, SOCK_STREAM, 0);
                        if (s >= 0) {
                            int on = 1;
                            h->socket_fd = s;
                            ioctl(s, FIONBIO, &on);
                            ioctl(s, FIOASYNC, &on);
                            memset(&sin, 0, sizeof(sin));
                            sin.sin_family = AF_INET;
                            sin.sin_port = htons(h->port);
                            memcpy(&sin.sin_addr, hp->h_addr, hp->h_length);
                            if (connect(s, (struct sockaddr *)&sin, sizeof(sin)) < 0) {
                                if (errno == EINPROGRESS) h->state = 2; // S_Connecting
                                else h->state = -5; // S_Unreachable
                            } else {
                                h->state = 4; // S_Connected
                            }
                        } else {
                            h->state = -4; // S_NoSockets
                        }
                    } else {
                        h->state = -1; // S_NoSuchHost
                    }
                } else {
                    h->state = -3; // S_ResolveError
                }
            }
        } else if (h->state == 2) { // S_Connecting
            // Check if connected
            struct fd_set write_fds;
            struct timeval tv;
            int error = 0;
            int len = sizeof(error);
            tv.tv_sec = 0;
            tv.tv_usec = 0;
            FD_ZERO(&write_fds);
            FD_SET(h->socket_fd, &write_fds);
            if (select(h->socket_fd + 1, NULL, &write_fds, NULL, &tv) > 0) {
                if (getsockopt(h->socket_fd, SOL_SOCKET, SO_ERROR, &error, &len) == 0) {
                    if (error == 0) h->state = 4; // S_Connected
                    else if (error == ECONNREFUSED) h->state = -6; // S_NotListening
                    else h->state = -5; // S_Unreachable
                } else {
                    h->state = -5;
                }
            }
        }
        h = h->next;
    }
}

_kernel_oserror *socket_get_state(socket_handle_t *h, int *state)
{
    socket_check_all();
    *state = h->state;
    return NULL;
}

_kernel_oserror *socket_forget(void *ptr)
{
    socket_handle_t **curr;
    socket_monitor_t **mcurr;
    
    curr = &socket_list;
    while (*curr) {
        if (*curr == ptr) {
            socket_handle_t *to_free = *curr;
            *curr = to_free->next;
            socket_free(to_free);
            return NULL;
        }
        curr = &((*curr)->next);
    }

    mcurr = &monitor_list;
    while (*mcurr) {
        if (*mcurr == ptr) {
            socket_monitor_t *to_free = *mcurr;
            *mcurr = to_free->next;
            free(to_free);
            return NULL;
        }
        mcurr = &((*mcurr)->next);
    }

    return Err_BadHandle;
}

static void update_monitors(socket_handle_t *h, int sent, int recv)
{
    socket_monitor_t *m = monitor_list;
    while (m) {
        if (m->handle == h) {
            if (sent > 0) m->data_sent += sent;
            if (recv > 0) {
                m->data_recv += recv;
                m->pollword = 1;
            }
        }
        m = m->next;
    }
}

_kernel_oserror *socket_send_line(socket_handle_t *h, const char *line, int flags)
{
    int len = 0;
    char cr = 13;
    char lf = 10;

    if (h->state != 4) return Err_NotConnected;

    if (flags & 4) { // 13-terminated
        while (line[len] != 13) len++;
    } else {
        len = strlen(line);
    }

    if (send(h->socket_fd, line, len, 0) < 0) {
        static _kernel_oserror err = {0, "Send failed"};
        return &err;
    }
    update_monitors(h, len, 0);

    if (!(flags & 1)) { // Want CR
        send(h->socket_fd, &cr, 1, 0);
        update_monitors(h, 1, 0);
    }
    if (!(flags & 2)) { // Want LF
        send(h->socket_fd, &lf, 1, 0);
        update_monitors(h, 1, 0);
    }

    return NULL;
}

_kernel_oserror *socket_read_line(socket_handle_t *h, char *buffer, int *size, int flags)
{
    int s = h->socket_fd;
    int max = *size;
    int i, found = 0, n;
    int term_type = flags & 3;
    int return_len;
    int strip;

    if (h->state != 4) return Err_NotConnected;

    // Search in existing buffer
    for (i = 0; i < h->buffer_len; i++) {
        int match = 0;
        char c = h->buffer[i];
        if (term_type == 0) { // CRLF
            if (c == '\r' && (i + 1) < h->buffer_len && h->buffer[i+1] == '\n') {
                found = i + 2;
                match = 1;
            }
        } else if (term_type == 1) { // LF
            if (c == '\n') {
                found = i + 1;
                match = 1;
            }
        } else if (term_type == 2) { // CR
            if (c == '\r') {
                found = i + 1;
                match = 1;
            }
        } else if (term_type == 3) { // Any
            if (c == '\r' || c == '\n') {
                found = i + 1;
                if (c == '\r' && (i + 1) < h->buffer_len && h->buffer[i+1] == '\n') {
                    found = i + 2;
                }
                match = 1;
            }
        }
        if (match) break;
    }

    if (!found) {
        n = recv(s, h->buffer + h->buffer_len, h->buffer_size - h->buffer_len, 0);
        if (n > 0) {
            h->buffer_len += n;
            update_monitors(h, 0, n);
            // Re-search
            for (i = 0; i < h->buffer_len; i++) {
                int match = 0;
                char c = h->buffer[i];
                if (term_type == 0) {
                    if (c == '\r' && (i + 1) < h->buffer_len && h->buffer[i+1] == '\n') {
                        found = i + 2;
                        match = 1;
                    }
                } else if (term_type == 1) {
                    if (c == '\n') {
                        found = i + 1;
                        match = 1;
                    }
                } else if (term_type == 2) {
                    if (c == '\r') {
                        found = i + 1;
                        match = 1;
                    }
                } else if (term_type == 3) {
                    if (c == '\r' || c == '\n') {
                        found = i + 1;
                        if (c == '\r' && (i + 1) < h->buffer_len && h->buffer[i+1] == '\n') {
                            found = i + 2;
                        }
                        match = 1;
                    }
                }
                if (match) break;
            }
        }
        if (!found && h->buffer_len == h->buffer_size && h->buffer_size < 32768) {
            int new_size = h->buffer_size * 2;
            char *new_buf = realloc(h->buffer, new_size);
            if (new_buf) {
                h->buffer = new_buf;
                h->buffer_size = new_size;
            }
        }
    }

    if (found) {
        strip = (term_type == 0) ? 2 : 1;
        if (term_type == 3) {
            if (h->buffer[found-2] == '\r' && h->buffer[found-1] == '\n') strip = 2;
            else strip = 1;
        }
        return_len = found - strip;
        if (found > max) {
            *size = found;
            return NULL;
        }
        memcpy(buffer, h->buffer, return_len);
        if (flags & 4) buffer[return_len] = 13;
        else buffer[return_len] = 0;
        if (flags & 8) {
            int src, dst = 0;
            for (src = 0; src < return_len; src++) {
                if (buffer[src] == 8 || buffer[src] == 127) {
                    if (dst > 0) dst--;
                } else {
                    buffer[dst++] = buffer[src];
                }
            }
            return_len = dst;
            if (flags & 4) buffer[return_len] = 13;
            else buffer[return_len] = 0;
        }
        memmove(h->buffer, h->buffer + found, h->buffer_len - found);
        h->buffer_len -= found;
        *size = return_len;
        return NULL;
    }
    *size = 0;
    return NULL;
}

_kernel_oserror *socket_send_data(socket_handle_t *h, const void *data, int *size)
{
    int n;
    if (h->state != 4) return Err_NotConnected;
    n = send(h->socket_fd, data, *size, 0);
    if (n < 0) {
        static _kernel_oserror err = {0, "Send data failed"};
        return &err;
    }
    update_monitors(h, n, 0);
    *size = n;
    return NULL;
}

_kernel_oserror *socket_read_data(socket_handle_t *h, void *buffer, int *size)
{
    int n, avail, s_avail;
    if (h->state != 4) return Err_NotConnected;
    if (buffer == NULL) {
        avail = h->buffer_len;
        s_avail = 0;
        ioctl(h->socket_fd, FIONREAD, &s_avail);
        *size = avail + s_avail;
        return NULL;
    }
    if (h->buffer_len > 0) {
        int to_copy = (*size < h->buffer_len) ? *size : h->buffer_len;
        memcpy(buffer, h->buffer, to_copy);
        memmove(h->buffer, h->buffer + to_copy, h->buffer_len - to_copy);
        h->buffer_len -= to_copy;
        *size = to_copy;
        return NULL;
    }
    n = recv(h->socket_fd, buffer, *size, 0);
    if (n < 0) {
        *size = 0;
        return NULL;
    }
    update_monitors(h, 0, n);
    *size = n;
    return NULL;
}

_kernel_oserror *socket_closed(socket_handle_t *h, int flags, int *closed)
{
    char dummy;
    int n;
    if (h->state != 4) {
        *closed = 1;
        return NULL;
    }
    if (!(flags & 1) && h->buffer_len > 0) {
        *closed = 0;
        return NULL;
    }
    n = recv(h->socket_fd, &dummy, 1, MSG_PEEK);
    *closed = (n == 0);
    return NULL;
}

_kernel_oserror *socket_listen(int port, socket_handle_t **handle)
{
    int s;
    struct sockaddr_in sin;
    socket_handle_t *h;
    int on = 1;
    int len;
    static _kernel_oserror err_sock = {0, "Socket creation failed"};
    static _kernel_oserror err_bind = {0, "Bind failed"};
    static _kernel_oserror err_list = {0, "Listen failed"};
    static _kernel_oserror err_mem  = {0, "Out of memory"};

    s = socket(AF_INET, SOCK_STREAM, 0);
    if (s < 0) return &err_sock;

    memset(&sin, 0, sizeof(sin));
    sin.sin_family = AF_INET;
    sin.sin_port = htons(port);
    sin.sin_addr.s_addr = INADDR_ANY;

    if (bind(s, (struct sockaddr *)&sin, sizeof(sin)) < 0) {
        close(s);
        return &err_bind;
    }

    if (listen(s, 5) < 0) {
        close(s);
        return &err_list;
    }

    ioctl(s, FIONBIO, &on);
    ioctl(s, FIOASYNC, &on);

    h = socket_alloc();
    if (!h) {
        close(s);
        return &err_mem;
    }

    h->socket_fd = s;
    h->remote_name = socket_strdup("LISTENING");
    if (port == 0) {
        len = sizeof(sin);
        getsockname(s, (struct sockaddr *)&sin, &len);
        h->port = ntohs(sin.sin_port);
    } else {
        h->port = port;
    }
    h->state = 3; // Listening
    *handle = h;
    return NULL;
}

_kernel_oserror *socket_accept(socket_handle_t *lh, int flags, socket_handle_t **new_handle)
{
    int s;
    struct sockaddr_in sin;
    int len = sizeof(sin);
    socket_handle_t *h;
    int on = 1;
    static _kernel_oserror err_accp = {0, "Accept failed"};
    static _kernel_oserror err_mem  = {0, "Out of memory"};

    if (lh->state != 3) {
        static _kernel_oserror err_nl = {0, "ESocket is not listening"};
        return &err_nl;
    }

    s = accept(lh->socket_fd, (struct sockaddr *)&sin, &len);
    if (s < 0) {
        if (errno == EWOULDBLOCK) {
            *new_handle = (socket_handle_t *)-8;
            return NULL;
        }
        return &err_accp;
    }

    ioctl(s, FIONBIO, &on);
    ioctl(s, FIOASYNC, &on);

    h = socket_alloc();
    if (!h) {
        close(s);
        return &err_mem;
    }

    h->socket_fd = s;
    h->remote_name = socket_strdup(inet_ntoa(sin.sin_addr));
    h->port = ntohs(sin.sin_port);
    h->state = 4; // Connected
    *new_handle = h;

    if (flags & 1) {
        socket_forget(lh);
    }

    return NULL;
}

_kernel_oserror *socket_connection_name(socket_handle_t *h, char **name)
{
    socket_check_all();
    *name = h->remote_name;
    return NULL;
}

void socket_close_all(unsigned int task_handle)
{
    socket_handle_t **curr;
    socket_monitor_t **mcurr;
    
    curr = &socket_list;
    while (*curr) {
        if (task_handle == 0 || (*curr)->task_handle == task_handle) {
            socket_handle_t *to_free = *curr;
            *curr = to_free->next;
            socket_free(to_free);
        } else {
            curr = &((*curr)->next);
        }
    }
    mcurr = &monitor_list;
    while (*mcurr) {
        if (task_handle == 0 || (*mcurr)->task_handle == task_handle) {
            socket_monitor_t *to_free = *mcurr;
            *mcurr = to_free->next;
            free(to_free);
        } else {
            mcurr = &((*mcurr)->next);
        }
    }
}

void socket_enumerate(void)
{
    socket_handle_t *h = socket_list;
    int count = 0;
    printf("Handle      Remote Host         Port   State  Task\n");
    printf("----------  -----------         ----   -----  ----\n");
    while (h) {
        printf("%08X  %-18s  %5d  %5d  %08X\n", (unsigned int)h, h->remote_name, h->port, h->state, h->task_handle);
        count++;
        h = h->next;
    }
    printf("Total: %d active connections\n", count);
}

_kernel_oserror *socket_monitor(socket_handle_t *h, socket_monitor_t **monitor)
{
    socket_monitor_t *m = malloc(sizeof(socket_monitor_t));
    if (!m) {
        static _kernel_oserror err_mem = {0, "Out of memory allocating monitor"};
        return &err_mem;
    }
    memset(m, 0, sizeof(socket_monitor_t));
    m->magic = MONITOR_MAGIC;
    m->handle = h;
    m->task_handle = get_current_task();
    m->next = monitor_list;
    monitor_list = m;
    *monitor = m;
    return NULL;
}

_kernel_oserror *socket_reset_monitor(socket_monitor_t *m, unsigned int *new_addr, unsigned int **poll_addr)
{
    m->pollword = 0;
    if (new_addr) {
        // Not implemented: original allowed setting custom pollword address
    }
    *poll_addr = (unsigned int *)&(m->pollword);
    return NULL;
}

void socket_monitor_enumerate(void)
{
    socket_monitor_t *m = monitor_list;
    int count = 0;
    printf("Monitor     Handle      Sent      Recv      PollAddr  Task\n");
    printf("----------  ----------  --------  --------  --------  ----\n");
    while (m) {
        printf("%08X  %08X  %8u  %8u  %08X  %08X\n", (unsigned int)m, (unsigned int)m->handle, 
               m->data_sent, m->data_recv, (unsigned int)&(m->pollword), m->task_handle);
        count++;
        m = m->next;
    }
    printf("Total: %d active monitors\n", count);
}

int socket_event_handler(_kernel_swi_regs *r, void *pw)
{
    int event = r->r[0];
    if (event == 19) { // Event_Internet
        int subreason = r->r[1];
        int s = r->r[2];
        if (subreason == 1 || subreason == 3) {
            socket_handle_t *h = socket_list;
            while (h) {
                if (h->socket_fd == s) {
                    socket_trigger_monitors((unsigned int)h);
                    break;
                }
                h = h->next;
            }
        }
    } else if (event == 2) { // Buffer entering (keyboard)
        socket_trigger_monitors(0);
    }
    return 1; // Pass on
}

void socket_trigger_monitors(int handle)
{
    socket_monitor_t *m = monitor_list;
    while (m) {
        if (handle == 0 || (unsigned int)m->handle == (unsigned int)handle) {
            m->pollword = 1;
        }
        m = m->next;
    }
}

const char *socket_decode_state(int state)
{
    switch (state) {
        case 1: return "Looking up address";
        case 2: return "Connecting to host";
        case 3: return "Listening for connection";
        case 4: return "Connected";
        case -1: return "Host lookup failed (doesn't exist?)";
        case -2: return "Resolve failed (no response)";
        case -3: return "Resolver error (not running?)";
        case -4: return "No sockets left";
        case -5: return "Host is unreachable (network down?)";
        case -6: return "Connection refused (not listening at destination)";
        case -7: return "Could not bind to local port";
        case -8: return "Nobody connected to socket";
        default: return "*** Unknown state ***";
    }
}

_kernel_oserror *socket_get_address(socket_handle_t *h, int remote, unsigned int *ip, int *port)
{
    struct sockaddr_in sin;
    int len = sizeof(sin);
    int res;
    if (h->state != 4 && h->state != 3) return Err_BadHandle;
    if (remote) res = getpeername(h->socket_fd, (struct sockaddr *)&sin, &len);
    else res = getsockname(h->socket_fd, (struct sockaddr *)&sin, &len);
    if (res < 0) {
        static _kernel_oserror err = {0, "Failed to get address"};
        return &err;
    }
    *ip = sin.sin_addr.s_addr;
    *port = ntohs(sin.sin_port);
    return NULL;
}

_kernel_oserror *socket_task_association(void *ptr, int associate)
{
    socket_handle_t *h;
    socket_monitor_t *m;
    if (socket_validate((int)ptr, &h) == NULL) {
        h->task_handle = associate ? get_current_task() : 0;
        return NULL;
    }
    if (socket_monitor_validate((int)ptr, &m) == NULL) {
        m->task_handle = associate ? get_current_task() : 0;
        return NULL;
    }
    return Err_BadHandle;
}
