#ifndef Wimp_RegisterFilter
#define Wimp_RegisterFilter 0x400D7
#endif
#ifndef Wimp_RemoveFilter
#define Wimp_RemoveFilter   0x400D8
#endif

#define DEBUG

#ifdef DEBUG
#define dprintf if (1) printf
#else
#define dprintf if (0) printf
#endif


/***************************************************************************
 * Function:     Mod_Init
 * Description:  Initialise the module
 **************************************************************************/
_kernel_oserror *Mod_Init(const char *tail, int podule_base, void *pw)
{
    _kernel_oserror *err;
    dprintf("Module EasySocket initialised\n");
    err = socket_init();
    if (err) return err;

    // Claim EventV
    err = _swix(OS_Claim, _INR(0,2), 16, Event_Entry, pw);
    if (err) return err;

    // Enable Events 2 and 19
    _swix(OS_Byte, _INR(0,1), 14, 2);
    _swix(OS_Byte, _INR(0,1), 14, 19);

    // Register Wimp Post-Filter
    _swix(Wimp_RegisterFilter, _INR(0,5), "ESockets TWInput", 1, PostFilter_Entry, pw, 0, 0);

    return NULL;
}


/***************************************************************************
 * Function:     Mod_Final
 * Description:  Finalise the module
 **************************************************************************/
_kernel_oserror *Mod_Final(int fatal, int podule_base, void *pw)
{
    dprintf("Module EasySocket dying\n");

    // Remove Wimp Post-Filter
    _swix(Wimp_RemoveFilter, _INR(0,5), "ESockets TWInput", 1, PostFilter_Entry, pw, 0, 0);

    // Disable Events
    _swix(OS_Byte, _INR(0,1), 13, 2);
    _swix(OS_Byte, _INR(0,1), 13, 19);

    // Release EventV
    _swix(OS_Release, _INR(0,2), 16, Event_Entry, pw);

    return socket_final();
}


/***************************************************************************
 * Function:     Mod_SWI
 * Description:  Handle SWI calls for the module.
 **************************************************************************/
_kernel_oserror *Mod_SWI(int number, _kernel_swi_regs *r, void *pw)
{
    _kernel_oserror *err = NULL;
    socket_handle_t *h;
    const char *hostname;
    int port;
    int state;
    const char *line;
    char *buffer;
    int size;
    const void *data;
    int closed;
    socket_handle_t *new_h;
    char *name;
    socket_monitor_t *m;
    int flags;
    unsigned int ip;
    unsigned int *poll_addr;

    socket_check_all();

    switch (number) {
        case ESocket_ConnectToHost - ESocket_00:
        {
            hostname = (const char *)r->r[0];
            port = r->r[1];
            err = socket_connect(hostname, port, &h);
            if (!err) {
                r->r[0] = (int)h;
            }
            return err;
        }

        case ESocket_CheckState - ESocket_00:
        {
            err = socket_validate(r->r[0], &h);
            if (err) return err;
            err = socket_get_state(h, &state);
            if (!err) {
                r->r[0] = state;
            }
            return err;
        }

        case ESocket_Forget - ESocket_00:
        {
            return socket_forget((void *)r->r[0]);
        }

        case ESocket_SendLine - ESocket_00:
        {
            err = socket_validate(r->r[0], &h);
            if (err) return err;
            line = (const char *)r->r[1];
            flags = r->r[2];
            return socket_send_line(h, line, flags);
        }

        case ESocket_ReadLine - ESocket_00:
        {
            err = socket_validate(r->r[0], &h);
            if (err) return err;
            buffer = (char *)r->r[1];
            size = r->r[2];
            flags = r->r[3];
            err = socket_read_line(h, buffer, &size, flags);
            if (!err) {
                if (buffer != NULL && size == 0) {
                    r->r[1] = 0;
                    r->r[2] = 0;
                } else if (buffer == NULL || size > r->r[2]) {
                    r->r[1] = 0;
                    r->r[2] = size;
                } else {
                    r->r[1] = (int)buffer;
                    r->r[2] = size;
                }
            }
            return err;
        }

        case ESocket_SendData - ESocket_00:
        {
            err = socket_validate(r->r[0], &h);
            if (err) return err;
            data = (const void *)r->r[1];
            size = r->r[2];
            err = socket_send_data(h, data, &size);
            if (!err) {
                r->r[0] = size;
            }
            return err;
        }

        case ESocket_ReadData - ESocket_00:
        {
            err = socket_validate(r->r[0], &h);
            if (err) return err;
            buffer = (char *)r->r[1];
            size = r->r[2];
            err = socket_read_data(h, buffer, &size);
            if (!err) {
                r->r[2] = size;
            }
            return err;
        }

        case ESocket_Closed - ESocket_00:
        {
            err = socket_validate(r->r[0], &h);
            if (err) return err;
            flags = r->r[1];
            err = socket_closed(h, flags, &closed);
            if (!err) {
                r->r[0] = closed;
            }
            return err;
        }

        case ESocket_Listen - ESocket_00:
        {
            port = r->r[0];
            err = socket_listen(port, &h);
            if (!err) {
                r->r[0] = (int)h;
                if (port == 0) r->r[1] = h->port;
            }
            return err;
        }

        case ESocket_Accept - ESocket_00:
        {
            err = socket_validate(r->r[0], &h);
            if (err) return err;
            flags = r->r[1];
            err = socket_accept(h, flags, &new_h);
            if (!err) {
                r->r[0] = (int)new_h;
            }
            return err;
        }

        case ESocket_ConnectionName - ESocket_00:
        {
            err = socket_validate(r->r[0], &h);
            if (err) return err;
            err = socket_connection_name(h, &name);
            if (!err) {
                r->r[0] = (int)name;
            }
            return err;
        }

        case ESocket_Monitor - ESocket_00:
        {
            if (r->r[0] != 0) {
                static _kernel_oserror err_bad_op = {0, "Unknown operation passed to ESocket_Monitor"};
                return &err_bad_op;
            }
            err = socket_validate(r->r[1], &h);
            if (err) return err;
            err = socket_monitor(h, &m);
            if (!err) {
                r->r[0] = (int)m;
            }
            return err;
        }

        case ESocket_ResetMonitor - ESocket_00:
        {
            err = socket_monitor_validate(r->r[0], &m);
            if (err) return err;
            err = socket_reset_monitor(m, (unsigned int *)r->r[1], &poll_addr);
            if (!err) {
                r->r[0] = (int)poll_addr;
            }
            return err;
        }

        case ESocket_OurAddress - ESocket_00:
        {
            err = socket_validate(r->r[0], &h);
            if (err) return err;
            err = socket_get_address(h, 0, &ip, &port);
            if (!err) {
                r->r[0] = ip;
                r->r[1] = port;
            }
            return err;
        }

        case ESocket_DecodeState - ESocket_00:
        {
            state = r->r[0];
            r->r[0] = (int)socket_decode_state(state);
            return NULL;
        }

        case ESocket_TaskAssociation - ESocket_00:
        {
            return socket_task_association((void *)r->r[0], r->r[1]);
        }

        case ESocket_ConnectToAddr - ESocket_00:
        {
            ip = r->r[0];
            port = r->r[1];
            err = socket_connect_addr(ip, port, &h);
            if (!err) {
                r->r[0] = (int)h;
            }
            return err;
        }

        case ESocket_TheirAddress - ESocket_00:
        {
            err = socket_validate(r->r[0], &h);
            if (err) return err;
            err = socket_get_address(h, 1, &ip, &port);
            if (!err) {
                r->r[0] = ip;
                r->r[1] = port;
            }
            return err;
        }

        default:
            return error_BAD_SWI;
    }
}


/***************************************************************************
 * Function:     Mod_Service
 * Description:  Handle Service calls for the module.
 **************************************************************************/
void Mod_Service(int service_number, _kernel_swi_regs *r, void *pw)
{
    if (service_number == 0x53) { // Service_WimpCloseDown
        socket_close_all((unsigned int)r->r[0]);
    }
}


/***************************************************************************
 * Function:     Mod_Command
 * Description:  Handle Star commands for the module.
 **************************************************************************/
_kernel_oserror *Mod_Command(const char *arg_string, int argc, int number, void *pw)
{
    switch (number) {
        case CMD_ESockets:
            socket_enumerate();
            break;
        case CMD_EMonitors:
            socket_monitor_enumerate();
            break;
    }
    return NULL;
}

/***************************************************************************
 * Function:     Event_Handler
 * Description:  Handle Events for the module.
 **************************************************************************/
int Event_Handler(_kernel_swi_regs *r, void *pw)
{
    return socket_event_handler(r, pw);
}

/***************************************************************************
 * Function:     PostFilter_Handler
 * Description:  Handle Wimp Post-Filter calls.
 **************************************************************************/
_kernel_oserror *PostFilter_Handler(_kernel_swi_regs *r, void *pw)
{
    int reason = r->r[0];
    unsigned int *block = (unsigned int *)r->r[1];
    if (reason == 17 || reason == 18) { // Message
        unsigned int msg_num = block[4]; // offset 16
        if (msg_num == 0x808C0) { // TaskWindow_Input
            socket_trigger_monitors(0);
        }
    }
    return NULL;
}
