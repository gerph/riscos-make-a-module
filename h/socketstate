#ifndef SOCKETSTATE_H
#define SOCKETSTATE_H

#include <sys/types.h>
#include <sys/socket.h>
#include <netinet/in.h>

#define SOCKET_MAGIC 0x58000958
#define MONITOR_MAGIC 0x4D4F4E49

typedef struct socket_handle {
    struct socket_handle *next;
    unsigned int magic;
    int socket_fd;
    char *remote_name;
    int port;
    int state;
    char *buffer;
    int buffer_size;
    int buffer_len;
    unsigned int task_handle;
} socket_handle_t;

typedef struct socket_monitor {
    struct socket_monitor *next;
    unsigned int magic;
    socket_handle_t *handle;
    unsigned int data_sent;
    unsigned int data_recv;
} socket_monitor_t;

_kernel_oserror *socket_validate(int handle, socket_handle_t **out);
_kernel_oserror *socket_monitor_validate(int monitor, socket_monitor_t **out);

_kernel_oserror *socket_init(void);
_kernel_oserror *socket_final(void);
_kernel_oserror *socket_connect(const char *hostname, int port, socket_handle_t **handle);
_kernel_oserror *socket_get_state(socket_handle_t *handle, int *state);
_kernel_oserror *socket_forget(socket_handle_t *handle);
_kernel_oserror *socket_send_line(socket_handle_t *handle, const char *line);
_kernel_oserror *socket_read_line(socket_handle_t *handle, char *buffer, int *size);
_kernel_oserror *socket_send_data(socket_handle_t *handle, const void *data, int *size);
_kernel_oserror *socket_read_data(socket_handle_t *handle, void *buffer, int *size);
_kernel_oserror *socket_closed(socket_handle_t *handle, int *closed);
_kernel_oserror *socket_listen(int port, socket_handle_t **handle);
_kernel_oserror *socket_accept(socket_handle_t *listen_handle, socket_handle_t **new_handle);
_kernel_oserror *socket_connection_name(socket_handle_t *handle, char **name);
void socket_enumerate(void);
void socket_close_all(unsigned int task_handle);

_kernel_oserror *socket_monitor(socket_handle_t *handle, socket_monitor_t **monitor);
_kernel_oserror *socket_reset_monitor(socket_monitor_t *monitor);
void socket_monitor_enumerate(void);

int socket_event_handler(_kernel_swi_regs *r, void *pw);

#endif
